{
  // Universum markdown linting configuration
  // Warnings only -- not blocking deployment

  // Allow long lines (prose doesn't wrap at 80 chars)
  "MD013": false,

  // Allow inline HTML (used for comments in scaffolded files)
  "MD033": false,

  // Allow duplicate headings (applications layer reuses section names)
  "MD024": false,

  // Allow trailing punctuation in headings (e.g., "What's Broken")
  "MD026": false,

  // Allow emphasis used instead of a heading
  "MD036": false,

  // Allow multiple top-level headings (front matter + H1)
  "MD025": false,

  // Allow bare URLs
  "MD034": false
}
